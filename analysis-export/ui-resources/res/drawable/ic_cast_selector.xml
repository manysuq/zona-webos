<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_checked="true" android:drawable="@drawable/ic_cast_connected" />
    <item android:state_enabled="true" android:state_checkable="true" android:drawable="@drawable/ic_cast_connecting" />
    <item android:state_enabled="true">
        <bitmap android:src="@drawable/ic_mr_button_disconnected_dark" android:tint="#ffffff" />
    </item>
    <item>
        <bitmap android:src="@drawable/ic_mr_button_disabled_dark" android:tint="#808080" />
    </item>
</selector>
